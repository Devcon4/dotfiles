    "c26": {
      "id": "c26",
      "num": 26,
      "title": "Card images (paste + attach + served files)",
      "body": "Screenshots/images on cards: paste into the description editor (uploads + inserts markdown at the caret), or `kb attach <board> <card> <file> [--alt text]`. Bytes are FILES at `docs/kanban/images/<board>/` served at `/images/…` — never base64 in board JSON (bloats every read, wrecks diffs). 10MB cap, png/jpg/webp/gif, traversal-guarded, immutable-cached (timestamped names).",
      "labels": [
        "shipped",
