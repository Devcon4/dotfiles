    "c27": {
      "id": "c27",
      "num": 27,
      "title": "Workflow shims (client.py / client.ts)",
      "body": "Importable clients for eval-orchestrated workflows: `skills/kanban/client.py` (zero-dep urllib) and `client.ts` (Bun/node fetch), one mirrored surface (reads, CRUD, link, brief, attach, search, activity, ensure_up). **Concurrency rule encoded:** all writes go through the HTTP API — the server is the single process holding the per-board write lock; parallel workers writing files/CLI directly can lose updates cross-process. Verified: 6 concurrent workers × mixed mutations on one board, zero lost updates, order/activity integrity gates green.",
      "labels": [
        "shipped",
        "feature"
      ],
      "size": null,
      "assignee": "ai",
      "color": null,
      "blocked": null,
      "blockedBy": [],
      "completed": true,
      "archived": false,
