    "debugToolBar.background": "#1B211C",
    "debugIcon.breakpointForeground": "#D9542F",
    "testing.iconPassed": "#7FA98A",
    "testing.iconFailed": "#E57352",
    "testing.iconQueued": "#D8A04A",

    "settings.headerForeground": "#F4EFE2",
    "settings.modifiedItemIndicator": "#D8A04A",
    "banner.background": "#2C3A30",
    "walkThrough.embeddedEditorBackground": "#151A16",

    "charts.foreground": "#E9E0CB",
    "charts.lines": "#4A5548",
    "charts.red": "#D9542F",
    "charts.blue": "#6B8CA3",
    "charts.yellow": "#D8A04A",
    "charts.orange": "#E57352",
    "charts.green": "#5F8A6C",
    "charts.purple": "#A9707E"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4A5548", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#7FA98A" }
    },
    {
      "name": "String escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class"],
      "settings": { "foreground": "#8FBFB6" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#E6B968" }
    },
    {
      "name": "Language constants (true, false, null, this)",
      "scope": ["constant.language", "variable.language"],
      "settings": { "foreground": "#C48D99" }
    },
    {
      "name": "Other constants and enum members",
      "scope": ["constant.other", "variable.other.enummember"],
      "settings": { "foreground": "#E6B968" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#E57352" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#B5AD97" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#D8A04A" }
    },
    {
      "name": "Types, classes, interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#6FA39A" }
    },
    {
      "name": "Namespaces and modules",
      "scope": ["entity.name.namespace", "entity.name.module", "storage.modifier.import.java"],
      "settings": { "foreground": "#8FBFB6" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": { "foreground": "#E9E0CB" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#F4EFE2", "fontStyle": "italic" }
    },
    {
      "name": "Object properties and members",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
      "settings": { "foreground": "#8DABBF" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#C48D99" }
    },
    {
      "name": "HTML/XML tags and YAML keys",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#5F8A6C" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#D8A04A", "fontStyle": "italic" }
    },
    {
      "name": "JSON property keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#6FA39A" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name"],
      "settings": { "foreground": "#8DABBF" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.separator", "punctuation.terminator", "meta.brace"],
      "settings": { "foreground": "#B5AD97" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#D8A04A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F4EFE2", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8DABBF" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#7FA98A" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#B5AD97", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#7FA98A" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#E57352" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#8DABBF" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D9542F" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8FBFB6",
    "type": "#6FA39A",
    "class": "#6FA39A",
    "interface": "#6FA39A",
    "enum": "#6FA39A",
    "struct": "#6FA39A",
    "typeParameter": "#8FBFB6",
    "function": "#D8A04A",
    "method": "#D8A04A",
    "property": "#8DABBF",
    "field": "#8DABBF",
    "enumMember": "#E6B968",
    "variable": "#E9E0CB",
    "variable.readonly": "#E6B968",
    "parameter": { "foreground": "#F4EFE2", "fontStyle": "italic" },
    "macro": "#C48D99",
    "decorator": "#C48D99",
    "keyword": "#E57352",
    "comment": { "foreground": "#4A5548", "fontStyle": "italic" },
    "string": "#7FA98A",
    "number": "#E6B968"
  }
}
