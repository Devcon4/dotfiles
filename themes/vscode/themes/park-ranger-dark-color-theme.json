    "terminal.ansiMagenta": "#A9707E",
    "terminal.ansiCyan": "#6FA39A",
    "terminal.ansiWhite": "#E9E0CB",
    "terminal.ansiBrightBlack": "#4A5548",
    "terminal.ansiBrightRed": "#E57352",
    "terminal.ansiBrightGreen": "#7FA98A",
    "terminal.ansiBrightYellow": "#E6B968",
    "terminal.ansiBrightBlue": "#8DABBF",
    "terminal.ansiBrightMagenta": "#C48D99",
    "terminal.ansiBrightCyan": "#8FBFB6",
    "terminal.ansiBrightWhite": "#F4EFE2",

    "input.background": "#1B211C",
    "input.foreground": "#E9E0CB",
    "input.border": "#2C3A30",
    "input.placeholderForeground": "#4A5548",
    "inputOption.activeBorder": "#6B8CA3",
    "inputOption.activeBackground": "#6B8CA333",
    "dropdown.background": "#1B211C",
    "dropdown.foreground": "#E9E0CB",
    "dropdown.border": "#2C3A30",
    "checkbox.background": "#1B211C",
    "checkbox.border": "#2C3A30",

    "button.background": "#5F8A6C",
    "button.foreground": "#121614",
    "button.hoverBackground": "#7FA98A",
    "button.secondaryBackground": "#2C3A30",
    "button.secondaryForeground": "#E9E0CB",
    "button.secondaryHoverBackground": "#35473B",

    "badge.background": "#D8A04A",
    "badge.foreground": "#121614",
    "progressBar.background": "#D8A04A",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#4A554855",
    "scrollbarSlider.hoverBackground": "#4A554888",
    "scrollbarSlider.activeBackground": "#4A5548BB",
    "minimap.selectionHighlight": "#35473B",
    "minimap.findMatchHighlight": "#D8A04A",

    "quickInput.background": "#1B211C",
    "quickInput.foreground": "#E9E0CB",
    "quickInputList.focusBackground": "#2C3A30",
