    [
        {
            "id": "User.SplitRight.Ubuntu",
            "keys": "ctrl+alt+plus"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "User.GlobalSummon",
            "keys": "alt+q"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        },
        {
            "id": "User.SplitRight.PowerShell",
            "keys": "ctrl+shift+plus"
        },
        {
            "id": "User.SplitDown.PowerShell",
            "keys": "ctrl+shift+minus"
        },
        {
            "id": "User.SplitDown.Ubuntu",
            "keys": "ctrl+alt+minus"
        },
        {
            "id": "Terminal.TogglePaneZoom",
            "keys": "alt+z"
        }
    ],
