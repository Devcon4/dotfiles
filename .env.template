# Machine identity for these dotfiles.
#   cp .env.template .env   and fill in -- or just run ./bootstrap.sh, which
#   auto-generates .env from detected values and stops for your review.
# .env is gitignored; the repo's config files only ever contain __VAR__
# placeholders (rendered at install by bootstrap.sh/bootstrap.ps1, restored
# at capture by sync.sh).

WIN_USER=""      # Windows username (the <you> in C:\Users\<you>)
WSL_USER=""      # Linux username inside the distro
WSL_DISTRO=""    # WSL distro name as it appears in \\wsl.localhost\<distro> (wsl -l -q)
GIT_NAME=""      # git user.name
GIT_EMAIL=""     # git user.email

# Optional -- only needed to sign the Firefox theme as an installable .xpi
# (themes/firefox/build.sh). Leave unset otherwise.
# Keys: https://addons.mozilla.org/developers/addon/api/key/
#WEB_EXT_API_KEY=""
#WEB_EXT_API_SECRET=""
